<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:clickable="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:importantForAccessibility="no"
            android:src="@drawable/feed_check_badge" />

        <TextView
            android:id="@+id/block_screen_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/block_screen_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:textColor="@color/ink_muted"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/block_screen_chat"
                style="@style/FeedCheckButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/go_to_chat"
                android:visibility="gone" />

            <Button
                android:id="@+id/block_screen_back"
                style="@style/FeedCheckButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/go_back" />

            <Button
                android:id="@+id/block_screen_exit"
                style="@style/FeedCheckButton.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
