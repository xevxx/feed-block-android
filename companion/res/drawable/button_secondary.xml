<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#241C6649">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape>
                    <corners android:radius="13dp" />
                    <solid android:color="@color/page_background" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="13dp" />
                    <solid android:color="@color/card_background" />
                    <stroke android:width="1dp" android:color="@color/line" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
